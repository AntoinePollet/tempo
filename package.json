{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "vite-ssg build",
    "cap:sync": "pnpm build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "worker:dev": "cd workers && wrangler dev",
    "worker:deploy": "cd workers && wrangler deploy",
    "worker:tail": "cd workers && wrangler tail",
    "worker:types": "cd workers && wrangler types",
    "worker:d1:create": "cd workers && wrangler d1 create tempo-prod",
    "worker:d1:apply": "cd workers && wrangler d1 execute tempo-prod --file=./schema.sql --remote",
    "worker:d1:apply-local": "cd workers && wrangler d1 execute tempo-prod --file=./schema.sql --local",
    "worker:secret": "cd workers && wrangler secret put",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "npx vite-bundle-visualizer"
  },
  "dependencies": {
    "@capacitor-firebase/app": "catalog:frontend",
    "@capacitor-firebase/messaging": "catalog:frontend",
    "@capacitor/android": "catalog:frontend",
    "@capacitor/core": "catalog:frontend",
    "@capacitor/ios": "catalog:frontend",
    "@capacitor/preferences": "catalog:frontend",
    "@unhead/vue": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "chart.js": "catalog:frontend",
    "date-fns": "catalog:frontend",
    "fuse.js": "catalog:frontend",
    "nprogress": "catalog:frontend",
    "pinia": "catalog:frontend",
    "pinia-plugin-persistedstate": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-chartjs": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "zod": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@capacitor/assets": "catalog:build",
    "@capacitor/cli": "catalog:build",
    "@cloudflare/workers-types": "catalog:dev",
    "@iconify-json/carbon": "catalog:dev",
    "@iconify-json/simple-icons": "catalog:dev",
    "@iconify/tailwind4": "catalog:build",
    "@intlify/unplugin-vue-i18n": "catalog:build",
    "@shikijs/markdown-it": "catalog:build",
    "@tailwindcss/vite": "catalog:build",
    "@types/markdown-it-link-attributes": "catalog:types",
    "@types/nprogress": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue-macros/volar": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "beasties": "catalog:build",
    "cypress": "catalog:dev",
    "cypress-vite": "catalog:dev",
    "daisyui": "catalog:build",
    "eslint": "catalog:dev",
    "eslint-plugin-cypress": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "https-localhost": "catalog:dev",
    "lint-staged": "catalog:dev",
    "markdown-it-link-attributes": "catalog:build",
    "rollup": "catalog:build",
    "shiki": "catalog:build",
    "simple-git-hooks": "catalog:dev",
    "tailwindcss": "catalog:build",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "unplugin-vue-macros": "catalog:build",
    "unplugin-vue-markdown": "catalog:build",
    "vite": "catalog:build",
    "vite-bundle-visualizer": "catalog:build",
    "vite-plugin-inspect": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:build",
    "vite-plugin-vue-layouts": "catalog:build",
    "vite-ssg": "catalog:build",
    "vite-ssg-sitemap": "catalog:build",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "resolutions": {
    "unplugin": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
